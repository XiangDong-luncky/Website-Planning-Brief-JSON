# V3 起服务端不保存、也不提供任何 API Key（BYOK）。
# 前端必须在每个生成请求里携带 userConfig：{ apiKey, baseUrl, modelName }。
# 本文件只保留本地开发用的服务端配置。

# thinking: disabled 关闭思考。仅对智谱域名（bigmodel.cn / z.ai）生效
ZHIPU_THINKING=disabled

# 单次模型请求超时秒数
LLM_TIMEOUT=180

# 各接口的最大输出 token
CHAT_MAX_TOKENS=1024
OUTLINE_MAX_TOKENS=6144
HTML_MAX_TOKENS=16000

# 历史对话字符预算，超出时丢弃最早的消息
HISTORY_CHAR_BUDGET=24000

# 1 = 不调用任何模型，三个接口返回 mock_data.py 里的示例数据（本地开发 / 前端联调）
MOCK_LLM=0
