# 复制本文件为 .env，填入你自己的配置（.env 不要提交到 git）
ZHIPU_API_KEY=在这里填你的智谱APIKey
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# thinking: disabled 关闭思考（JSON 模式推荐，速度快且不会把思考内容混进 JSON）
#            enabled  开启思考（质量可能更好，但慢、费 token）
#            default  不传该参数，使用模型默认行为
ZHIPU_THINKING=disabled

# 单次请求超时秒数。生成 4 个页面的 HTML 可能接近 1~2 分钟
LLM_TIMEOUT=180

# 单次回复的最大 token 数。4 个页面约需 8k~10k，太小吃不下完整 JSON
MAX_TOKENS=12000

# 1 = 不调用智谱，直接返回 mock_data.py 里的示例数据（前端联调用）
MOCK_LLM=0
